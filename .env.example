# Copy this file to .env and fill in real values. Never commit .env.
# See docs/ai/conventions.md for how env vars are consumed in Nuxt runtimeConfig.

# --- Site ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB (Atlas) ---
# Connection string for the MongoDB Atlas cluster. See docs/adr/0002-mongodb-over-postgres.md
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=sauna_store

# --- Email (Resend) ---
# See docs/adr/0006-resend-for-email.md
RESEND_API_KEY=
RESEND_FROM_EMAIL="Bastuguiden <no-reply@example.com>"

# --- Cron / ingestion ---
# Shared secret checked by server/api/cron/* routes before running any ingestion
# or expiration task. Vercel Cron sends this as a bearer token / header.
CRON_SECRET=

# --- Admin auth ---
# Single-operator admin login. See docs/adr referencing admin auth (Phase 7).
ADMIN_PASSWORD=
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Analytics (Umami) ---
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_SCRIPT_URL=

# --- Spam protection (optional, Phase 6) ---
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
